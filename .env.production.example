# ============================================================================
# CRACKFLOW - Production Environment Configuration
# NEVER commit this file with real values - use secret manager
# ============================================================================

# Application
NODE_ENV=production
PORT=5000
CLIENT_URL=https://crackflow.example.com
WS_URL=wss://crackflow.example.com

# Database (pulled from secret manager)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=crackflow
DB_USER=crackflow
DB_PASSWORD=${VAULT_DB_PASSWORD}
MYSQL_ROOT_PASSWORD=${VAULT_MYSQL_ROOT_PASSWORD}

# Authentication (pulled from secret manager)
JWT_SECRET=${VAULT_JWT_SECRET}
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Isolated execution service (externally provisioned; HTTPS is required)
SANDBOX_MODE=judge0
JUDGE0_URL=${VAULT_JUDGE0_URL}
JUDGE0_API_KEY=${VAULT_JUDGE0_API_KEY}

# Redis
REDIS_URL=redis://redis:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=/app/uploads

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# SSL/Domain
DOMAIN=crackflow.example.com
SSL_EMAIL=admin@example.com

# Backup
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=${VAULT_BACKUP_S3_BUCKET}
AWS_ACCESS_KEY_ID=${VAULT_AWS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${VAULT_AWS_SECRET_KEY}
AWS_REGION=us-east-1
