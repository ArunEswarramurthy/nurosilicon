PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crackflow_dev
DB_USER=root
DB_PASS=replace_with_strong_local_password
JWT_SECRET=replace_with_32_plus_character_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SANDBOX_MODE=judge0
JUDGE0_URL=
JUDGE0_API_KEY=

# Gmail — for password reset OTP emails
# Use a Gmail App Password (not your Gmail login password)
# Setup: Google Account → Security → 2-Step Verification → App passwords
MAIL_USER=nurobytes.tech@gmail.com
MAIL_PASS=replace_with_gmail_app_password

# Optional: set your ngrok tunnel URL for local dev (dev only, never set in production)
# NGROK_URL=https://your-tunnel.ngrok-free.dev

# Privileged bootstrap values must be supplied explicitly; never commit real secrets.
SUPERADMIN_EMAIL=superadmin@your-domain.example
SUPERADMIN_PASSWORD=replace_with_strong_superadmin_password
